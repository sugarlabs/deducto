#: activity/activity.info:2
msgid "Deducto"
msgstr "Deducto"

#: DeductoActivity.py:95
#, python-format
msgid "Resuming level %d"
msgstr "ვაგრძელებ დონეზე %d"

#: DeductoActivity.py:119
msgid "Start a new game."
msgstr "ახალი თამაშის დაწყება."

#: DeductoActivity.py:125 DeductoActivity.py:260
msgid "The pattern matches the rule."
msgstr "ნიმუში წესს ემთხვევა."

#: DeductoActivity.py:129 DeductoActivity.py:262
msgid "The pattern does not match the rule."
msgstr "ნიმუში წესს არ ემთხვევა."

#: DeductoActivity.py:135 DeductoActivity.py:258
msgid "Explore some examples."
msgstr "დაათვალიერეთ მაგალითები."

#: DeductoActivity.py:144
msgid "Load a custom level."
msgstr "მორგებული დონის ჩატვირთვა."

#: DeductoActivity.py:164 DeductoActivity.py:175 DeductoActivity.py:263
#: DeductoActivity.py:428
#, python-format
msgid "Playing level %d"
msgstr "თამაშობთ დონეს %d"

#: DeductoActivity.py:166
msgid "Only sharer can start a new game."
msgstr "ახალი თამაშის დაწყება, მხოლოდ, გამზიარებელს შეუძლია."

#: DeductoActivity.py:173
msgid "Game over."
msgstr "თამაში დასრულდა."

#: DeductoActivity.py:186 DeductoActivity.py:217
msgid "Click on new game button to begin."
msgstr "დასაწყებად დააწკაპუნეთ ახალი თამაშის ღილაკზე."

#: DeductoActivity.py:188 DeductoActivity.py:219
msgid "Wait for sharer to start a new game."
msgstr "ახალი თამაშის დასაწყებად დაელოდეთ გამზიარებელს."

#: DeductoActivity.py:200 DeductoActivity.py:230
#, python-format
msgid "%d correct answers."
msgstr "%d სწორი პასუხი."

#: DeductoActivity.py:206
msgid "Pattern was false."
msgstr "ნიმუში ცრუა."

#: DeductoActivity.py:236
msgid "Pattern was true."
msgstr "ნიმუში ჭეშმარიტია."

#: DeductoActivity.py:247
msgid "Resume play"
msgstr "თამაშის გაგრძელება"

#: DeductoActivity.py:249
msgid "Show a pattern that matches the rule."
msgstr "ჩვენება ნიმუშის, რომელიც წესს ემთხვევა."

#: DeductoActivity.py:251
msgid "Show a pattern that does not match the rule."
msgstr "აჩვენებს ნიმუშს, რომელიც წესს არ ემთხვევა."

#: DeductoActivity.py:254
msgid "Explore patterns with the {} and {} buttons."
msgstr "ნიმუშების დათვალიერება ღილაკებით {} და {}."

#: DeductoActivity.py:270
msgid "Load a \"True\" pattern generator from the journal"
msgstr "\"ჭეშმარიტი\" ნიმუშის გენერატორის ჩატვირთვა ჟურნალიდან"

#: DeductoActivity.py:277
msgid "Load a \"False\" pattern generator from the journal"
msgstr "\"ცრუ\" ნიმუშის გენერატორის ჩატვირთვა ჟურნალიდან"

#: DeductoActivity.py:283
msgid "New level added"
msgstr "დაემატა ახალი დონე"

#: DeductoActivity.py:122
msgid "Game"
msgstr "თამაში"
